# Copy to .env (local) or set in your hosting provider's environment settings.
# NEVER commit real secrets.

# PostgreSQL. On Vercel use a pooled URL for DATABASE_URL and a direct
# (non-pooled) URL for DIRECT_URL, which Prisma migrations need.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campusbite?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/campusbite?schema=public"

# Public base URL of the app (used for links in emails)
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# College integration provider: mock | college-api | oidc | readonly-db | csv-sync
# Only "mock" is implemented today. See src/lib/college/README.md.
COLLEGE_PROVIDER="mock"
# Comma-separated list of email domains allowed to activate student accounts
COLLEGE_EMAIL_DOMAINS="college.edu"
# Future: official college API (server-side only, never exposed to the browser)
COLLEGE_API_BASE_URL=""
COLLEGE_API_KEY=""

# Payments: simulator | razorpay
PAYMENT_PROVIDER="simulator"
# The simulator is for development/pilot only. Set to "false" in real production.
PAYMENT_SIMULATOR_ENABLED="true"
PAYMENT_SIMULATOR_SECRET="generate-a-long-random-string"
# Razorpay (use TEST keys first). Webhook secret is set in the Razorpay dashboard.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email: dev-outbox stores messages in the database (viewable at /dev/mailbox).
# Production needs a real provider (SMTP / transactional email) — see README.
EMAIL_PROVIDER="dev-outbox"
# Enables /dev/* tools (mailbox). Must be "false" in production.
DEV_TOOLS_ENABLED="true"

# Shared secret for scheduled jobs (Vercel Cron sends it as a Bearer token)
CRON_SECRET="generate-a-long-random-string"
