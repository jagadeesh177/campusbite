# Copy to .env (local) or set in your hosting provider's environment settings.
# NEVER commit real secrets.

# PostgreSQL. On Vercel use a pooled URL for DATABASE_URL and a direct
# (non-pooled) URL for DIRECT_URL, which Prisma migrations need.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campusbite?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/campusbite?schema=public"

# Public base URL of the app (used for links in emails)
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# User registration, email verification, passwords and login — Supabase Auth.
# Project Settings → API. Only the anon / publishable key is needed (never the service-role key).
# Emails are sent by Supabase through Resend SMTP — configure that in the Supabase dashboard (see README).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Payments: simulator | razorpay
PAYMENT_PROVIDER="simulator"
# The simulator is for development/pilot only. Set to "false" in real production.
PAYMENT_SIMULATOR_ENABLED="true"
PAYMENT_SIMULATOR_SECRET="generate-a-long-random-string"
# Razorpay — Dashboard → (Test Mode) → Account & Settings → API Keys.
# Test keys start with rzp_test_. Keep the secret server-side only (never NEXT_PUBLIC_*).
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Any long random string; paste the SAME value into Razorpay → Webhooks → Secret.
RAZORPAY_WEBHOOK_SECRET=""
# Safety switch: live keys (rzp_live_…) are refused unless this is exactly "true".
RAZORPAY_ALLOW_LIVE="false"

# Shared secret for scheduled jobs (Vercel Cron sends it as a Bearer token)
CRON_SECRET="generate-a-long-random-string"
